# Structured environment variables for local development/testing.
#
# Copy this file to `.env.local` (preferred) or `.env`, then fill in values.
# Never commit real credentials.

# EG4 cloud portal credentials
EG4_PORTAL__USERNAME="your_eg4_username"
EG4_PORTAL__PASSWORD="your_eg4_password"

# Optional Home Assistant API settings for tooling
HOME_ASSISTANT__BASE_URL="http://192.168.0.253:8123"
HOME_ASSISTANT__TOKEN="your_long_lived_access_token"
